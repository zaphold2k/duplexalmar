# Copiar a .env y completar con valores reales. Nunca commitear .env.

# Credenciales del panel de administración (/admin). Único usuario.
ADMIN_USERNAME=
# Hash de la contraseña, nunca la contraseña en texto plano.
# Generar con: npm run hash-password -- "la-contraseña"
ADMIN_PASSWORD_HASH=

# Secreto usado para firmar la cookie de sesión. Mínimo 32 caracteres aleatorios.
# Generar con: openssl rand -base64 32
SESSION_SECRET=

# Número de WhatsApp del anfitrión en formato internacional, sólo dígitos (sin "+" ni espacios).
# Ejemplo: 5492235293371
WHATSAPP_NUMBER=

# Directorio donde persisten los manifests y las imágenes procesadas.
# En desarrollo, un directorio local; en producción, el punto de montaje del volumen.
DATA_DIR=./data

# Límites de subida de fotos desde el panel.
MAX_UPLOAD_FILE_SIZE_MB=15
MAX_UPLOAD_BATCH_SIZE=20

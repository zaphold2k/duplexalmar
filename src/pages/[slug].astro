---
import Gallery from '../components/Gallery.astro';
import NotFoundContent from '../components/NotFoundContent.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { getHouseContent, isHouseSlug, type HouseSlug } from '../content/houses';
import { whatsAppMessageForHouse } from '../lib/whatsapp';
import BaseLayout from '../layouts/BaseLayout.astro';
import { config } from '../server/config';
import { getEffectiveCoverId, readManifest } from '../server/houses';
import { applicableVariantWidths, imageVariantUrl } from '../server/images';

const { slug } = Astro.params;
const validSlug: HouseSlug | null = slug !== undefined && isHouseSlug(slug) ? slug : null;

if (validSlug === null) {
  Astro.response.status = 404;
}

const pageData =
  validSlug === null
    ? null
    : await (async (houseSlug: HouseSlug) => {
        const house = getHouseContent(houseSlug);
        const manifest = await readManifest(config.dataDir, houseSlug);
        const coverId = getEffectiveCoverId(manifest);
        const coverImage = coverId !== null ? manifest.images[coverId] : undefined;
        const galleryImages = manifest.gallery.flatMap((id) => {
          const image = manifest.images[id];
          return image ? [{ id, ...image }] : [];
        });
        return { house, coverId, coverImage, galleryImages };
      })(validSlug);

const ogImagePath =
  pageData?.coverId !== undefined && pageData.coverId !== null && pageData.coverImage
    ? imageVariantUrl(
        pageData.house.slug,
        pageData.coverId,
        applicableVariantWidths(pageData.coverImage.width).at(-1) ?? 480,
      )
    : undefined;
---

{pageData === null ? (
  <BaseLayout
    title="Página no encontrada — Las Petras — Casas de Mar"
    description="Esta casa no existe. Las casas disponibles son la Casa Rosa y la Casa Verde."
  >
    <NotFoundContent message="Esta casa no existe. Las casas disponibles son la Casa Rosa y la Casa Verde." />
  </BaseLayout>
) : (
  <BaseLayout
    title={`${pageData.house.name} — Las Petras — Casas de Mar`}
    description={pageData.house.tagline}
    house={pageData.house.slug}
    ogImagePath={ogImagePath}
  >
    <main>
      <header class="house-hero">
        {pageData.coverId !== null && pageData.coverImage ? (
          <ResponsiveImage
            houseSlug={pageData.house.slug}
            imageId={pageData.coverId}
            width={pageData.coverImage.width}
            height={pageData.coverImage.height}
            alt={pageData.coverImage.alt || `Portada de ${pageData.house.name}`}
            sizes="100vw"
            loading="eager"
            fetchpriority="high"
            class="house-hero__image"
          />
        ) : (
          <img
            src="/images/reserve-cover.jpg"
            alt={pageData.house.name}
            width="1200"
            height="630"
            class="house-hero__image"
          />
        )}
        <div class="house-hero__caption">
          <h1>{pageData.house.name}</h1>
          <p>{pageData.house.tagline}</p>
        </div>
      </header>

      <section class="house-section">
        <p>{pageData.house.description}</p>
      </section>

      <section class="house-section" aria-labelledby="capacidad-titulo">
        <h2 id="capacidad-titulo">Capacidad</h2>
        <ul>
          <li>Hasta {pageData.house.capacity.maxGuests} personas</li>
          <li>
            {pageData.house.capacity.bedrooms} dormitorio(s), {pageData.house.capacity.bathrooms}{' '}
            baño(s), {pageData.house.capacity.floors} plantas
          </li>
          <li>{pageData.house.capacity.beds}</li>
        </ul>
      </section>

      <section class="house-section" aria-labelledby="destacados-titulo">
        <h2 id="destacados-titulo">Lo que la distingue</h2>
        <ul>
          {pageData.house.highlights.map((highlight) => (
            <li>{highlight}</li>
          ))}
        </ul>
      </section>

      <section class="house-section" aria-labelledby="servicios-titulo">
        <h2 id="servicios-titulo">Servicios</h2>
        <ul>
          {pageData.house.services.map((service) => (
            <li>{service}</li>
          ))}
        </ul>
      </section>

      <section class="house-section" aria-labelledby="galeria-titulo">
        <h2 id="galeria-titulo">Galería</h2>
        <Gallery houseSlug={pageData.house.slug} images={pageData.galleryImages} />
      </section>

      <section class="house-section" aria-labelledby="estadia-titulo">
        <h2 id="estadia-titulo">Para tener en cuenta</h2>
        <ul>
          {pageData.house.rules.map((rule) => (
            <li>{rule}</li>
          ))}
        </ul>
      </section>

      {/*
        Un solo botón, hijo directo de <main>: con position: sticky flota al
        pie de la pantalla mientras se recorre la página y, al llegar al
        final, se asienta en su lugar sin tapar el contenido.
      */}
      <WhatsAppButton message={whatsAppMessageForHouse(pageData.house.name)} variant="sticky" />
    </main>
  </BaseLayout>
)}

<style>
  .house-hero {
    position: relative;
  }

  /*
   * 65% del alto de la ventana, en cualquier pantalla: así siempre asoma
   * el contenido que sigue debajo de la foto. `svh` toma el alto con la
   * barra del navegador del celular visible (el caso más chico), para que
   * el corte no cambie al desplazarse; `vh` queda de reserva.
   */
  .house-hero__image {
    width: 100%;
    height: 65vh;
    height: 65svh;
    object-fit: cover;
  }

  .house-hero__caption {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    padding: var(--space-4);
    background: linear-gradient(to top, rgb(0 0 0 / 55%), transparent);
    color: white;
  }

  .house-section {
    max-width: var(--max-content-width);
    margin-inline: auto;
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
</style>

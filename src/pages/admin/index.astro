---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Placeholder protegido por el guardia de sesión (ver src/middleware.ts): la
// selección de casa y la galería se construyen en la tarea 7.1.
---

<BaseLayout
  title="Panel — Las Petras — Casas de Mar"
  description="Panel de administración."
  noindex
>
  <main class="panel">
    <h1>Panel</h1>
    <p>Sesión iniciada.</p>
    <form method="post" action="/admin/logout">
      <button type="submit" class="panel__logout">
        Cerrar sesión
      </button>
    </form>
  </main>
</BaseLayout>

<style>
  .panel {
    max-width: 24rem;
    margin: var(--space-6) auto;
    padding: 0 var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .panel__logout {
    min-height: var(--touch-target-min);
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: none;
    font-weight: 600;
    cursor: pointer;
  }
</style>

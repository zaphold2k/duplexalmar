---
import { whatsAppUrl } from '../lib/whatsapp';
import { config } from '../server/config';

export interface Props {
  message: string;
  label?: string;
  /**
   * `sticky` ancla el botón al pie de la pantalla para que quede accesible
   * sin volver al principio de la página (ver spec sitio-publico, "Acceso
   * permanente al contacto en celular"). Se usa en las páginas de casa.
   */
  variant?: 'inline' | 'sticky';
  class?: string;
}

const {
  message,
  label = 'Consultar por WhatsApp',
  variant = 'inline',
  class: className,
} = Astro.props;

const href = whatsAppUrl(config.whatsapp.number, message);
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class:list={['whatsapp-button', variant === 'sticky' && 'whatsapp-button--sticky', className]}
>
  {label}
</a>

<style>
  .whatsapp-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: var(--touch-target-min);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-md);
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    font-weight: 600;
    text-decoration: none;
    text-align: center;
  }

  .whatsapp-button--sticky {
    position: fixed;
    inset-inline: var(--space-3);
    inset-block-end: var(--space-3);
    z-index: 40;
    box-shadow: 0 0.25rem 1rem rgb(0 0 0 / 25%);
  }
</style>

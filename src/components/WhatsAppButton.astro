---
import { whatsAppUrl } from '../lib/whatsapp';
import { config } from '../server/config';

export interface Props {
  message: string;
  label?: string;
  /**
   * `sticky` hace que el botón flote al pie de la pantalla mientras se
   * recorre la página y se asiente en su lugar al llegar al final (ver spec
   * sitio-publico, "Acceso permanente al contacto en celular"). Se usa en
   * las páginas de casa; debe ser hijo directo de <main> para que el área
   * en la que flota abarque toda la página.
   */
  variant?: 'inline' | 'sticky';
  class?: string;
}

const {
  message,
  label = 'Consultar por WhatsApp',
  variant = 'inline',
  class: className,
} = Astro.props;

const href = whatsAppUrl(config.whatsapp.number, message);
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class:list={['whatsapp-button', variant === 'sticky' && 'whatsapp-button--sticky', className]}
>
  {label}
</a>

<style>
  .whatsapp-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: var(--touch-target-min);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-md);
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    font-weight: 600;
    text-decoration: none;
    text-align: center;
  }

  .whatsapp-button--sticky {
    position: sticky;
    inset-block-end: var(--space-3);
    display: flex;
    margin-block: var(--space-4);
    margin-inline: var(--space-3);
    z-index: 40;
    box-shadow: 0 0.25rem 1rem rgb(0 0 0 / 25%);
  }

  @media (min-width: 40rem) {
    .whatsapp-button--sticky {
      max-width: var(--max-content-width);
      margin-inline: auto;
    }
  }
</style>

---
import { effectiveImageAlt, getHouseContent, type HouseSlug } from '../content/houses';
import { applicableVariantWidths, imageVariantUrl } from '../server/images';
import ResponsiveImage from './ResponsiveImage.astro';

export interface Props {
  houseSlug: HouseSlug;
  images: { id: string; alt: string; width: number; height: number }[];
}

const { houseSlug, images } = Astro.props;
const houseName = getHouseContent(houseSlug).name;

const lightboxImages = images.map((image) => {
  const widths = applicableVariantWidths(image.width);
  const largestWidth = widths.at(-1) ?? 480;
  return {
    src: imageVariantUrl(houseSlug, image.id, largestWidth),
    srcset: (widths.length > 0 ? widths : [480])
      .map((w) => `${imageVariantUrl(houseSlug, image.id, w)} ${String(w)}w`)
      .join(', '),
    alt: effectiveImageAlt(image.alt, houseName),
    width: image.width,
    height: image.height,
  };
});
---

{images.length > 0 && (
  <div class="gallery" data-lightbox data-images={JSON.stringify(lightboxImages)}>
    <ul class="gallery__grid">
      {images.map((image, index) => (
        <li>
          <button
            type="button"
            class="gallery__thumb"
            data-lightbox-trigger
            aria-label={`Ampliar foto ${String(index + 1)} de ${String(images.length)}: ${effectiveImageAlt(image.alt, houseName)}`}
          >
            <ResponsiveImage
              houseSlug={houseSlug}
              imageId={image.id}
              width={image.width}
              height={image.height}
              alt=""
              sizes="(min-width: 640px) 33vw, 50vw"
            />
          </button>
        </li>
      ))}
    </ul>

    <dialog class="gallery__dialog" aria-label="Vista ampliada de la galería">
      <button type="button" data-lightbox-close class="gallery__close" aria-label="Cerrar">
        ✕
      </button>
      <button
        type="button"
        data-lightbox-prev
        class="gallery__nav gallery__nav--prev"
        aria-label="Foto anterior"
      >
        ‹
      </button>
      {/* El alt se completa por JS (Lightbox.show) al mostrar cada foto. */}
      <img class="gallery__image" alt="" />
      <button
        type="button"
        data-lightbox-next
        class="gallery__nav gallery__nav--next"
        aria-label="Foto siguiente"
      >
        ›
      </button>
      <p class="gallery__caption" />
    </dialog>
  </div>
)}

<style>
  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .gallery__thumb {
    display: block;
    width: 100%;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
    min-height: var(--touch-target-min);
  }

  .gallery__thumb :global(img) {
    aspect-ratio: 4 / 3;
    object-fit: cover;
    width: 100%;
    border-radius: var(--radius-sm);
  }

  .gallery__dialog {
    position: fixed;
    inset: 0;
    max-width: 100vw;
    max-height: 100vh;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: var(--space-3);
    border: none;
    background: rgb(0 0 0 / 92%);
    color: white;
  }

  .gallery__dialog::backdrop {
    background: rgb(0 0 0 / 92%);
  }

  .gallery__dialog[open] {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .gallery__image {
    max-width: 100%;
    max-height: 75vh;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .gallery__caption {
    color: white;
    margin-top: var(--space-3);
    text-align: center;
  }

  .gallery__close,
  .gallery__nav {
    position: absolute;
    min-width: var(--touch-target-min);
    min-height: var(--touch-target-min);
    border: none;
    border-radius: var(--radius-md);
    background: rgb(255 255 255 / 15%);
    color: white;
    font-size: var(--step-2);
    cursor: pointer;
  }

  .gallery__close {
    top: var(--space-3);
    right: var(--space-3);
  }

  .gallery__nav--prev {
    left: var(--space-3);
    top: 50%;
    transform: translateY(-50%);
  }

  .gallery__nav--next {
    right: var(--space-3);
    top: 50%;
    transform: translateY(-50%);
  }
</style>

<script>
  interface LightboxImage {
    src: string;
    srcset: string;
    alt: string;
    width: number;
    height: number;
  }

  class Lightbox {
    private dialog: HTMLDialogElement;
    private imageEl: HTMLImageElement;
    private captionEl: HTMLElement | null;
    private images: LightboxImage[];
    private currentIndex = 0;
    private originElement: HTMLElement | null = null;
    private touchStartX: number | null = null;

    constructor(root: HTMLElement) {
      const dialog = root.querySelector('dialog');
      const imageEl = root.querySelector<HTMLImageElement>('.gallery__image');
      if (!dialog || !imageEl) {
        throw new Error('Gallery: falta el <dialog> o el <img> de la vista ampliada');
      }
      this.dialog = dialog;
      this.imageEl = imageEl;
      this.captionEl = root.querySelector('.gallery__caption');
      this.images = JSON.parse(root.dataset.images ?? '[]') as LightboxImage[];

      root
        .querySelectorAll<HTMLButtonElement>('[data-lightbox-trigger]')
        .forEach((thumb, index) => {
          thumb.addEventListener('click', () => {
            this.originElement = thumb;
            this.show(index);
            this.dialog.showModal();
          });
        });

      root
        .querySelector('[data-lightbox-close]')
        ?.addEventListener('click', () => this.dialog.close());
      root
        .querySelector('[data-lightbox-prev]')
        ?.addEventListener('click', () => this.show(this.currentIndex - 1));
      root
        .querySelector('[data-lightbox-next]')
        ?.addEventListener('click', () => this.show(this.currentIndex + 1));

      this.dialog.addEventListener('keydown', (event) => this.onKeydown(event));
      this.dialog.addEventListener('close', () => this.originElement?.focus());
      // Cerrar al tocar el fondo (fuera de la imagen y los controles).
      this.dialog.addEventListener('click', (event) => {
        if (event.target === this.dialog) this.dialog.close();
      });

      this.dialog.addEventListener('touchstart', (event) => {
        this.touchStartX = event.touches[0]?.clientX ?? null;
      });
      this.dialog.addEventListener('touchend', (event) => {
        if (this.touchStartX === null) return;
        const endX = event.changedTouches[0]?.clientX ?? this.touchStartX;
        const delta = endX - this.touchStartX;
        this.touchStartX = null;
        const SWIPE_THRESHOLD_PX = 40;
        if (delta > SWIPE_THRESHOLD_PX) this.show(this.currentIndex - 1);
        else if (delta < -SWIPE_THRESHOLD_PX) this.show(this.currentIndex + 1);
      });
    }

    private show(index: number): void {
      const total = this.images.length;
      this.currentIndex = ((index % total) + total) % total;
      const data = this.images[this.currentIndex];
      if (!data) return;
      this.imageEl.src = data.src;
      this.imageEl.srcset = data.srcset;
      this.imageEl.alt = data.alt;
      this.imageEl.width = data.width;
      this.imageEl.height = data.height;
      if (this.captionEl) this.captionEl.textContent = data.alt;
    }

    private onKeydown(event: KeyboardEvent): void {
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        this.show(this.currentIndex + 1);
      } else if (event.key === 'ArrowLeft') {
        event.preventDefault();
        this.show(this.currentIndex - 1);
      }
      // Escape lo maneja el <dialog> nativamente y dispara el evento "close".
    }
  }

  document.querySelectorAll<HTMLElement>('[data-lightbox]').forEach((root) => new Lightbox(root));
</script>

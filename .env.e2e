# Entorno del server que levanta docker-compose.e2e.yml para la suite e2e.
# Sí se commitea: son credenciales de prueba, conocidas y sin ningún valor
# fuera de los tests. Tienen que coincidir con e2e/env.ts.
#
# Usuario: admin — Contraseña: prueba-123
# El hash lleva cada $ como $$ porque Docker Compose interpola los env_file
# (ver .env.docker.example). Para regenerarlo:
#   npm run hash-password -- prueba-123 | sed 's/$/$$/g'

ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=scrypt$$32768$$8$$1$$KALRxPhT3A9bWJ6NR7bVig==$$lSEKIEjDkR9kKo6USTSd/QbwFs82oclQCy+RhEryy2tUYqf/vrVgh1RSMi7+BA4VI7VITB/e+6A95UfVHQS4bQ==
SESSION_SECRET=secreto-de-prueba-solo-para-e2e-no-usar-en-produccion-0123456789
WHATSAPP_NUMBER=5491100000000
MAX_UPLOAD_FILE_SIZE_MB=15
MAX_UPLOAD_BATCH_SIZE=20

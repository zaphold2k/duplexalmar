# Copiar a .env.docker y completar con valores reales. Nunca commitear
# .env.docker.
#
# Es un archivo aparte de `.env` (el que usa `npm run dev`) a propósito:
# Docker Compose reescanea el contenido de cada `env_file` buscando `$VAR`
# para interpolar, así que cualquier `$` literal —como los que separan los
# campos de un hash scrypt— hay que escribirlo doble (`$$`) para que llegue
# intacto al contenedor. Node y Vite no hacen esa reinterpretación, así que
# `.env` lleva el hash con un solo `$`, tal como lo imprime
# `npm run hash-password`.
#
# Ejemplo: si `npm run hash-password -- "..."` imprime
#   scrypt$32768$8$1$sal$hash
# acá va como
#   scrypt$$32768$$8$$1$$sal$$hash

ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
WHATSAPP_NUMBER=
MAX_UPLOAD_FILE_SIZE_MB=15
MAX_UPLOAD_BATCH_SIZE=20
